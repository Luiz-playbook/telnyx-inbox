node_modules/
.DS_Store
Thumbs.db

# Dev server output when it's started detached rather than in a terminal.
# Redirect into logs/ (logs/dev-server.log, logs/dev-3005.log for a second port) so a new
# log file never needs a new ignore rule. .gitkeep is tracked so the folder exists on clone.
# `logs/*` rather than `logs/` — git does not descend into an excluded directory, so the
# negation below would never be reached.
logs/*
!logs/.gitkeep

# stray logs from before logs/ existed
dev-*.log
dev-*.log.err

# Local runtime config — contains the Supabase anon key + reply secret.
# Copy ui/config.example.js -> ui/config.js and fill it in locally.
ui/config.js

# Local env files feeding scripts/gen-config.js (and `vercel dev`).
.env
.env.*
!.env.example

# local design reference, not part of the deliverable
slsmage.png

# design reference, not part of the deliverable
Marketing Blaster Design Prompt.zip

# meeting notes, not part of the deliverable
meeting-transcripts/

# Bruno API collection — local request scratchpad, not part of the deliverable.
bruno/

# Do-not-contact CSVs (suppression/). REAL PEOPLE'S EMAIL ADDRESSES AND PHONE NUMBERS, and
# specifically of people who have asked not to be contacted — the last data that should sit in a
# repo, on anyone's laptop, or in a cloud backup of it. Drop the files in, import them, and the
# database is the record; the CSV is a courier, not a home.
# The README and .gitkeep are tracked so the folder exists on clone and explains itself.
suppression/*
!suppression/.gitkeep
!suppression/README.md
