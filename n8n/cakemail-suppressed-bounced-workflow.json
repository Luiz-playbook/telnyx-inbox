      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const BOUNCE_TYPES = [\"bounce_hb\", \"bounce_sb\", \"bounce_mb\", \"bounce_df\", \"bounce_fm\", \"bounce_tr\", \"bounce_cr\", \"bounce_ac\", \"bounce_ar\"];\nconst OWNER = \"Josh\";\nconst rows = [];\nfor (const item of $input.all()) {\n  for (const bounceType of BOUNCE_TYPES) {\n    rows.push({\n      json: {\n        owner: OWNER,\n        campaign_id: item.json.id,\n        campaign_name: item.json.name,\n        bounce_type: bounceType\n      }\n    });\n  }\n}\nreturn rows;"
      }
