      "id": "d883b4a2-b80c-4839-b4af-0dc91d483e52",
      "name": "Keep Campaigns Last 30 Days [Cole]",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        740,
        176
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "in-window",
              "leftValue": "={{ $json.scheduled_on || 0 }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": "={{ Math.floor($now.minus({ days: 30 }).toSeconds()) }}"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "ed3780d4-cc22-4df9-89f6-b3b7dfd49d2d",
      "name": "Expand By Bounce Type [Cole]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        176
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const BOUNCE_TYPES = [\"bounce_hb\", \"bounce_sb\", \"bounce_mb\", \"bounce_df\", \"bounce_fm\", \"bounce_tr\", \"bounce_cr\", \"bounce_ac\", \"bounce_ar\"];\nconst OWNER = \"Cole\";\nconst rows = [];\nfor (const item of $input.all()) {\n  for (const bounceType of BOUNCE_TYPES) {\n    rows.push({\n      json: {\n        owner: OWNER,\n        campaign_id: item.json.id,\n        campaign_name: item.json.name,\n        bounce_type: bounceType\n      }\n    });\n  }\n}\nreturn rows;"
      }
    },
